# Konfigurasi Go backend (dibaca oleh config.go)
API_BASE_URL=http://api-pusat.domain.com/api/v1
WS_URL=ws://api-pusat.domain.com/ws
MOCK_API=false

# Backend render untuk display. Default (kosong): X11/XWayland (posisi window
# display diatur aplikasi, tapi video YouTube besar bisa drop frame di WebKitGTK).
# Set "wayland" agar video mulus (0 frame drop, zero-copy) bila sesi Wayland;
# konsekuensinya posisi window display diatur compositor.
DISPLAY_BACKEND=

# Konfigurasi Vite (referensi saja; api.js memakai GetConfig() dari Go)
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Realtime Database (isi oleh admin)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
